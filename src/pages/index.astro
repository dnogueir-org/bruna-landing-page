---
import Layout from '../layouts/Layout.astro';
---
<Layout>

  <!-- ═══════════════════════════════════════════
       NAVIGATION
  ═══════════════════════════════════════════ -->
  <header id="top" class="fixed top-0 inset-x-0 z-50 bg-cream/90 backdrop-blur-sm border-b border-blush">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">

      <!-- Logo / Name -->
      <a href="/#top" class="flex flex-col leading-tight">
        <span class="font-serif text-xl font-semibold tracking-wide text-ink">Bruna Nogueira</span>
        <span class="font-sans text-[10px] font-medium tracking-widest text-taupe uppercase">Advogada · OAB/MG 233.848</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8 font-sans text-sm font-medium text-taupe">
        <a href="/#sobre"   class="nav-link hover:text-ink transition-colors">Sobre</a>
        <a href="/#areas"   class="nav-link hover:text-ink transition-colors">Áreas</a>
        <a href="/blog"     class="nav-link hover:text-ink transition-colors">Blog</a>
        <a href="/#contato" class="nav-link hover:text-ink transition-colors">Contato</a>
        <a href="/#contato"
           class="ml-2 px-5 py-2 rounded-full bg-rose text-white text-sm font-medium hover:bg-bark transition-colors">
          Fale Conosco
        </a>
      </nav>

      <!-- Mobile hamburger -->
      <label for="mobile-menu-toggle" class="md:hidden cursor-pointer text-taupe" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </label>
    </div>

    <!-- Mobile nav -->
    <input type="checkbox" id="mobile-menu-toggle" class="hidden peer" />
    <nav class="md:hidden max-h-0 overflow-hidden peer-checked:max-h-72 transition-all duration-300 bg-cream border-t border-blush">
      <div class="flex flex-col px-6 py-4 gap-4 font-sans text-sm font-medium text-taupe">
        <a href="/#sobre"   class="hover:text-rose transition-colors">Sobre</a>
        <a href="/#areas"   class="hover:text-rose transition-colors">Áreas de Atuação</a>
        <a href="/blog"     class="hover:text-rose transition-colors">Blog</a>
        <a href="/#contato" class="hover:text-rose transition-colors">Contato</a>
        <a href="/#contato"
           class="mt-1 text-center px-5 py-2 rounded-full bg-rose text-white hover:bg-bark transition-colors">
          Fale Conosco
        </a>
      </div>
    </nav>
  </header>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative min-h-screen flex items-center px-6 pt-24 pb-20 overflow-hidden">

    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-blush/30 blur-3xl"></div>
    </div>

    <div class="relative max-w-6xl mx-auto w-full grid md:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Photo -->
      <div class="fade-in flex justify-center">
        <div class="relative">
          <img src="/bruna.jpg" alt="Dra. Bruna Nogueira"
               class="relative w-72 h-96 md:w-80 md:h-[480px] object-cover object-top rounded-2xl shadow-lg z-10" />
          <div class="absolute -bottom-3 -right-3 w-full h-full rounded-2xl border border-rose/30"></div>
        </div>
      </div>

      <!-- Text -->
      <div class="fade-in">
        <p class="font-sans text-xs font-semibold tracking-[0.25em] uppercase text-rose mb-6">
          Advocacia &amp; Assessoria Jurídica
        </p>
        <h1 class="font-serif text-5xl md:text-7xl font-light leading-tight text-ink mb-4">
          Bruna<br />
          Nogueira
        </h1>
        <p class="font-sans text-xs tracking-widest uppercase text-rose/80 mb-8">
          OAB/MG 233.848
        </p>
        <p class="font-sans text-base md:text-lg font-light text-taupe max-w-xl leading-relaxed mb-10">
          Comprometida com a defesa dos seus direitos. Atuação estratégica e atendimento humanizado em Direito Médico e da Saúde, Direito Administrativo e Direito Civil e do Consumidor.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a href="#contato"
             class="flex items-center gap-2 px-8 py-3.5 rounded-full bg-rose text-white font-sans text-sm font-medium hover:bg-bark transition-colors shadow-sm">
            Agendar Consulta
          </a>
          <a href="#sobre"
             class="px-8 py-3.5 rounded-full border border-rose text-rose font-sans text-sm font-medium hover:bg-blush/50 transition-colors">
            Saiba Mais
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
      <span class="font-sans text-[10px] tracking-widest uppercase text-taupe">Rolar</span>
      <div class="w-px h-10 bg-gradient-to-b from-rose to-transparent"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SOBRE
  ═══════════════════════════════════════════ -->
  <section id="sobre" class="bg-warm py-24 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">

      <!-- Quote card -->
      <div class="fade-in order-2 md:order-1">
        <div class="relative bg-blush/40 rounded-2xl border border-rose/20 p-10 flex flex-col items-center justify-center min-h-64 text-center gap-5">
          <div class="absolute top-4 right-4 w-full h-full rounded-2xl border border-rose/15 -z-10"></div>
          <span class="font-serif text-8xl text-rose/25 leading-none select-none -mb-4">"</span>
          <h2 class="font-serif text-3xl md:text-4xl font-light text-bark leading-snug italic">
            Advocacia com dedicação e ética
          </h2>
          <span class="font-serif text-8xl text-rose/25 leading-none select-none rotate-180 -mt-4">"</span>
          <div class="w-8 h-px bg-rose/40"></div>
          <p class="font-sans text-[11px] tracking-widest uppercase text-rose/70">Bruna Nogueira</p>
        </div>
      </div>

      <!-- Bio text -->
      <div class="fade-in order-1 md:order-2">
        <p class="font-sans text-xs font-semibold tracking-[0.2em] uppercase text-rose mb-6">Sobre</p>
        <div class="space-y-4 font-sans text-sm text-taupe leading-relaxed font-light">
          <p>
            Formada em Direito pela Universidade Federal da Grande Dourados – UFGD, possui pós-graduação em Compliance Médico e Jurídico pelo Grupo Minas, e em Direito da Medicina pela Universidade de Coimbra, Portugal.
          </p>
          <p>
            Tem sólida atuação em Direito Médico e da Saúde, Direito Administrativo, Direito Civil e do Consumidor.
          </p>
          <p>
            A sua prática está fundamentada em uma conduta ética e relacionamento transparente com o cliente, além da busca constante pela atualização e conhecimento.
          </p>
          <p>
            Por meio do atendimento individual, personalizado e estratégico, busca mitigar riscos voltados à atuação do profissional da saúde, defender os interesses dos pacientes contra planos de saúde e SUS, afastar condenações disciplinares de servidores e agentes públicos, e promover a igualdade nos concursos públicos.
          </p>
          <p class="pt-4 border-t border-blush font-serif text-base italic text-taupe">
            Missão: traduzir a linguagem do Direito em soluções práticas para a vida de cada cliente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       ÁREAS DE ATUAÇÃO
  ═══════════════════════════════════════════ -->
  <section id="areas" class="py-24 px-6">
    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-16 fade-in section-rule">
        <p class="font-sans text-xs font-semibold tracking-[0.2em] uppercase text-rose mb-3">Especialidades</p>
        <h2 class="font-serif text-4xl md:text-5xl font-light text-ink">
          Áreas de <span class="italic">Atuação</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">

        <!-- Direito Médico e da Saúde -->
        <article class="area-card fade-in bg-warm rounded-2xl p-8 border border-blush/50">
          <div class="w-12 h-12 rounded-full bg-blush flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-semibold text-bark mb-3">Direito Médico e da Saúde</h3>
          <ul class="space-y-3 font-sans text-sm text-taupe font-light">
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Defesa dos interesses dos profissionais da saúde em processos cíveis e administrativos
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Busca de tratamentos para pacientes em processos judiciais contra planos de saúde e contra o SUS
            </li>
          </ul>
        </article>

        <!-- Direito Administrativo -->
        <article class="area-card fade-in bg-warm rounded-2xl p-8 border border-blush/50" style="transition-delay: 0.1s">
          <div class="w-12 h-12 rounded-full bg-blush flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10h1v11H4M19 10h1v11h-1M9 10h1v11H9M14 10h1v11h-1"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-semibold text-bark mb-3">Direito Administrativo</h3>
          <ul class="space-y-3 font-sans text-sm text-taupe font-light">
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Defesa de servidores públicos, notários e registradores em processos administrativos disciplinares
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Ampla prática no Conselho Nacional de Justiça, nas Corregedorias Extrajudiciais, Conselhos da Magistratura e Órgãos Especiais dos Tribunais de Justiça
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Proteção de concursandos e da igualdade nos concursos públicos
            </li>
          </ul>
        </article>

        <!-- Direito Civil e do Consumidor -->
        <article class="area-card fade-in bg-warm rounded-2xl p-8 border border-blush/50" style="transition-delay: 0.2s">
          <div class="w-12 h-12 rounded-full bg-blush flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 10c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-semibold text-bark mb-3">Direito Civil e do Consumidor</h3>
          <ul class="space-y-3 font-sans text-sm text-taupe font-light">
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Responsabilidade civil e indenizações
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Contratos e assessoria preventiva
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Cobranças e negativações indevidas
            </li>
            <li class="flex items-start gap-2">
              <span class="text-rose mt-0.5 shrink-0">—</span>
              Restituição de valores para vítimas de golpes (Pix, falsa central de banco…)
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       DIFERENCIAIS
  ═══════════════════════════════════════════ -->
  <section class="bg-warm py-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14 fade-in section-rule">
        <h2 class="font-serif text-4xl font-light text-ink">
          Por que nos <span class="italic">escolher?</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-10 text-center">

        <div class="fade-in">
          <div class="w-14 h-14 rounded-full bg-blush mx-auto flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-bark mb-2">Atendimento Humanizado</h3>
          <p class="font-sans text-sm text-taupe font-light leading-relaxed">
            Cada cliente é ouvido com atenção e respeito. Acreditamos que clareza e empatia são tão importantes quanto o conhecimento técnico-jurídico.
          </p>
        </div>

        <div class="fade-in" style="transition-delay: 0.1s">
          <div class="w-14 h-14 rounded-full bg-blush mx-auto flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-bark mb-2">Fundamentação Sólida</h3>
          <p class="font-sans text-sm text-taupe font-light leading-relaxed">
            Estratégias jurídicas construídas sobre a legislação e a jurisprudência vigentes, com rigor técnico e atualização constante.
          </p>
        </div>

        <div class="fade-in" style="transition-delay: 0.2s">
          <div class="w-14 h-14 rounded-full bg-blush mx-auto flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-bark mb-2">Comunicação Transparente</h3>
          <p class="font-sans text-sm text-taupe font-light leading-relaxed">
            Você é informado em cada etapa do processo. Nenhuma decisão é tomada sem o seu conhecimento e consentimento.
          </p>
        </div>

        <div class="fade-in" style="transition-delay: 0.3s">
          <div class="w-14 h-14 rounded-full bg-blush mx-auto flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-bark mb-2">Conhecimento Interdisciplinar</h3>
          <p class="font-sans text-sm text-taupe font-light leading-relaxed">
            Acreditamos que o conhecimento em áreas distintas do Direito nos proporciona uma visão integral, estratégica e atenta aos detalhes de cada caso.
          </p>
        </div>

        <div class="fade-in" style="transition-delay: 0.4s">
          <div class="w-14 h-14 rounded-full bg-blush mx-auto flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-taupe" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605"/>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-bark mb-2">Habilidade em Despachos e Sustentações Orais</h3>
          <p class="font-sans text-sm text-taupe font-light leading-relaxed">
            A prática em despachos e sustentações orais nos Tribunais de Justiça, Conselhos da Magistratura, Órgãos Especiais e Conselho Nacional de Justiça nos proporcionou desenvoltura profissional, um discurso sintetizado e planejado para cada fase processual.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CONTATO
  ═══════════════════════════════════════════ -->
  <section id="contato" class="py-24 px-6">
    <div class="max-w-2xl mx-auto fade-in">
      <div class="text-center mb-12">
        <p class="font-sans text-xs font-semibold tracking-[0.2em] uppercase text-rose mb-4">Contato</p>
        <h2 class="font-serif text-4xl md:text-5xl font-light text-ink mb-5">
          Vamos <span class="italic">conversar?</span>
        </h2>
        <p class="font-sans text-sm text-taupe font-light leading-relaxed max-w-lg mx-auto">
          Entre em contato para agendar um atendimento, tirar suas dúvidas e para que eu possa entender como te ajudar. O primeiro passo começa com uma conversa.
        </p>
      </div>

      <form id="contato-form" class="bg-warm rounded-2xl border border-blush p-8 space-y-6">

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="f-nome" class="block font-sans text-xs font-semibold tracking-widest uppercase text-taupe mb-2">Nome</label>
            <input id="f-nome" type="text" placeholder="Seu nome completo"
              class="w-full bg-cream border border-blush rounded-xl px-4 py-3 font-sans text-sm text-ink placeholder-taupe/50 focus:outline-none focus:border-rose transition-colors" />
          </div>
          <div>
            <label for="f-cidade" class="block font-sans text-xs font-semibold tracking-widest uppercase text-taupe mb-2">Cidade</label>
            <input id="f-cidade" type="text" placeholder="Sua cidade / estado"
              class="w-full bg-cream border border-blush rounded-xl px-4 py-3 font-sans text-sm text-ink placeholder-taupe/50 focus:outline-none focus:border-rose transition-colors" />
          </div>
        </div>

        <div>
          <p class="font-sans text-xs font-semibold tracking-widest uppercase text-taupe mb-3">Área de interesse</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <label class="area-pill flex items-center gap-2 cursor-pointer select-none px-4 py-2.5 rounded-full border border-blush bg-cream font-sans text-sm text-taupe transition-colors hover:border-rose">
              <input type="checkbox" value="Direito Médico e da Saúde" class="area-check sr-only" />
              <span class="area-dot w-2 h-2 rounded-full bg-blush shrink-0 transition-colors"></span>
              Direito Médico e da Saúde
            </label>
            <label class="area-pill flex items-center gap-2 cursor-pointer select-none px-4 py-2.5 rounded-full border border-blush bg-cream font-sans text-sm text-taupe transition-colors hover:border-rose">
              <input type="checkbox" value="Direito Administrativo" class="area-check sr-only" />
              <span class="area-dot w-2 h-2 rounded-full bg-blush shrink-0 transition-colors"></span>
              Direito Administrativo
            </label>
            <label class="area-pill flex items-center gap-2 cursor-pointer select-none px-4 py-2.5 rounded-full border border-blush bg-cream font-sans text-sm text-taupe transition-colors hover:border-rose">
              <input type="checkbox" value="Direito Civil e do Consumidor" class="area-check sr-only" />
              <span class="area-dot w-2 h-2 rounded-full bg-blush shrink-0 transition-colors"></span>
              Direito Civil e do Consumidor
            </label>
          </div>
        </div>

        <div>
