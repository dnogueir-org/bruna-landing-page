---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---
<Layout
  title={`${post.data.title} | Bruna Nogueira Advocacia`}
  description={post.data.excerpt}
>

  <!-- Nav -->
  <header class="fixed top-0 inset-x-0 z-50 bg-cream/90 backdrop-blur-sm border-b border-blush">
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex flex-col leading-tight">
        <span class="font-serif text-xl font-semibold tracking-wide text-ink">Bruna Nogueira</span>
        <span class="font-sans text-[10px] font-medium tracking-widest text-taupe uppercase">Advogada · OAB/MG 233.848</span>
      </a>
      <nav class="hidden md:flex items-center gap-8 font-sans text-sm font-medium text-taupe">
        <a href="/#sobre"   class="nav-link hover:text-ink transition-colors">Sobre</a>
        <a href="/#areas"   class="nav-link hover:text-ink transition-colors">Áreas</a>
        <a href="/blog"     class="nav-link hover:text-ink transition-colors">Blog</a>
        <a href="/#contato" class="nav-link hover:text-ink transition-colors">Contato</a>
        <a href="/#contato" class="ml-2 px-5 py-2 rounded-full bg-rose text-white text-sm font-medium hover:bg-bark transition-colors">
          Fale Conosco
        </a>
      </nav>
    </div>
  </header>

  <article class="bg-cream pt-24 pb-24">

    <!-- Hero image or warm band -->
    {post.data.heroImage ? (
      <div class="w-full h-72 md:h-[420px] overflow-hidden">
        <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover" />
      </div>
    ) : (
      <div class="w-full h-24 bg-warm"></div>
    )}

    <div class="max-w-3xl mx-auto px-6 mt-12">

      <!-- Back -->
      <a href="/blog" class="font-sans text-xs font-medium text-rose hover:underline flex items-center gap-1 mb-10">
        ← Voltar para artigos
      </a>

      <!-- Meta -->
      {post.data.category && (
        <p class="font-sans text-[10px] font-semibold tracking-widest uppercase text-rose mb-3">
          {post.data.category}
        </p>
      )}
      <h1 class="font-serif text-4xl md:text-5xl font-light text-ink mb-4 leading-tight">
        {post.data.title}
      </h1>
      <p class="font-sans text-sm text-taupe/70 mb-12">
        {new Date(post.data.pubDate).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}
      </p>

      <div class="w-12 h-px bg-blush mb-12"></div>

      <!-- Body -->
      <div class="article-body font-sans text-sm text-taupe leading-relaxed font-light">
        <Content />
      </div>

      <!-- CTA -->
      <div class="mt-20 pt-12 border-t border-blush text-center">
        <p class="font-serif text-2xl font-light text-ink mb-2">Precisa de assessoria jurídica?</p>
        <p class="font-sans text-sm text-taupe font-light mb-6">Entre em contato para um atendimento personalizado.</p>
        <a href="/#contato"
           class="inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-rose text-white font-sans text-sm font-medium hover:bg-bark transition-colors shadow-sm">
          Fale com a Dra. Bruna
        </a>
      </div>
    </div>
  </article>

  <!-- Footer -->
  <footer class="bg-ink text-cream/60 py-12 px-6">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-center md:text-left">
        <p class="font-serif text-2xl text-cream font-light">Bruna Nogueira</p>
        <p class="font-sans text-xs tracking-widest uppercase text-rose mt-1">Advogada · OAB/MG 233.848</p>
      </div>
      <div class="text-center font-sans text-xs leading-relaxed">
        <p><a href="tel:+5567981023008" class="hover:text-cream transition-colors">(67) 98102-3008</a></p>
        <p><a href="mailto:Nogueirabruna.adv@gmail.com" class="hover:text-cream transition-colors">Nogueirabruna.adv@gmail.com</a></p>
      </div>
      <div class="text-center md:text-right font-sans text-xs">
        <p>© {new Date().getFullYear()} Bruna Nogueira Advocacia.</p>
      </div>
    </div>
  </footer>

</Layout>
